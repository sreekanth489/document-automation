# =============================================================================
# Extraction Provider Configuration
# =============================================================================
# Choose one of: anthropic, ollama_vision, ollama_ocr
EXTRACTION_PROVIDER=anthropic

# =============================================================================
# Anthropic Configuration (for EXTRACTION_PROVIDER=anthropic)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# =============================================================================
# Ollama Configuration (for EXTRACTION_PROVIDER=ollama_vision or ollama_ocr)
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434

# Vision model for EXTRACTION_PROVIDER=ollama_vision
# Options: llava:13b, llava:34b, qwen-vl, bakllava, etc.
OLLAMA_VISION_MODEL=llava:13b

# Text model for EXTRACTION_PROVIDER=ollama_ocr
# Options: numind/numarkdown-8b-thinking, llama3.1:8b, mistral, etc.
OLLAMA_TEXT_MODEL=numind/numarkdown-8b-thinking

# Timeout in seconds for Ollama requests (default: 120)
OLLAMA_TIMEOUT=120

# =============================================================================
# OCR Configuration (for EXTRACTION_PROVIDER=ollama_ocr)
# =============================================================================
# OCR engine: easyocr (default) or tesseract
OCR_ENGINE=easyocr

# Languages for OCR (comma-separated)
# EasyOCR codes: en, fr, es, de, etc.
# Tesseract codes: eng, fra, spa, deu, etc.
OCR_LANGUAGES=en

# =============================================================================
# Application Settings
# =============================================================================
FORM_URL=https://mendrika-alma.github.io/form-submission/
